# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# app
/data/
/dist/
/.e2e/
# DB 백업(개인 데이터라 커밋하지 않음)
/backups/
/.check-backups/
# 릴리스 묶음(이미지 압축 파일, scripts/release.sh가 만듦)
/release-dist/

# Claude Code 개인 설정(공용 설정 .claude/settings.json만 커밋)
/.claude/settings.local.json

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# vim 스왑 파일
*.swp

# Rust(rust/)
/rust/target/
/rust/tools/tailwindcss
/rust/tools/tailwindcss.download
/rust/ripple/static/app.css
