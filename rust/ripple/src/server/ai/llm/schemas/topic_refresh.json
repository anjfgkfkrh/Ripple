{
  "type": "object",
  "properties": {
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "이어지는 토픽이면 이전 토픽의 id 그대로, 새 토픽이면 빈 문자열"
          },
          "name": {
            "type": "string",
            "description": "토픽 이름(짧은 명사구)"
          },
          "summary": {
            "type": "string",
            "description": "지금 무슨 일이 있는지 한국어 한 줄"
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "이 토픽 기사를 찾는 검색어 2~4개(1~3단어, 제목에 쓰인 그대로)"
          },
          "related": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "string",
                  "description": "'내 종목'에 있는 이름 그대로"
                },
                "reason": {
                  "type": "string",
                  "description": "이 토픽이 그 종목에 어떻게 이어지는지 한국어 한 줄"
                }
              },
              "required": [
                "item",
                "reason"
              ],
              "additionalProperties": false
            },
            "description": "영향을 받을 만한 내 종목. 없으면 빈 목록"
          },
          "scope": {
            "type": "string",
            "enum": [
              "market",
              "company"
            ],
            "description": "market: 증시 전체나 여러 업종에 퍼지는 토픽. company: 내 종목에 직접 걸린 특정 회사·사업 건"
          }
        },
        "required": [
          "id",
          "name",
          "summary",
          "terms",
          "related",
          "scope"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "topics"
  ],
  "additionalProperties": false
}
