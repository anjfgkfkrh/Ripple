# 로컬 실행용 환경변수 예시. 복사해서 .env로 쓴다: cp .env.example .env
# Docker(compose)에서는 아래 0단계 값을 compose 파일이 컨테이너용 값으로 정한다.

# ── 0단계 ─────────────────────────────────────────
# SQLite 파일 경로 (Docker: /data/ripple.db, named volume)
DATABASE_PATH=./data/ripple.db
# web → worker 내부 API 주소 (Docker: http://worker:4000)
WORKER_URL=http://127.0.0.1:4000
# worker 내부 API가 듣는 주소·포트 (Docker: 0.0.0.0)
WORKER_HOST=127.0.0.1
WORKER_PORT=4000
TZ=Asia/Seoul

# ── 1단계: 로그인 (web만 사용) ─────────────────────
# 로그인 비밀번호. 7자 이상이 아니면 web이 시작하지 않는다.
APP_PASSWORD=
# 세션 서명 키. 32자 이상. 만들기: openssl rand -base64 48
# 바꾸면 모든 로그인이 풀린다.
SESSION_SECRET=

# ── 2단계: 종목 등록 ───────────────────────────────
# web → worker 내부 API 공유 토큰(32자 이상, web·worker 둘 다 사용). 만들기: openssl rand -base64 48
WORKER_API_TOKEN=
# OpenRouter API 키(worker만 사용). 없으면 worker는 뜨지만 종목 찾기는 쓸 수 없다.
# OpenRouter 화면에서 키에 사용 한도를 걸어 두는 것을 권장한다.
OPENROUTER_API_KEY=

# ── 4단계: 기사 수집 ───────────────────────────────
# Finnhub API 키(worker만 사용, 무료 가입 https://finnhub.io). 없으면 미국 뉴스는 건너뛰고 언론사 RSS만 모은다.
FINNHUB_API_KEY=

# ── 5단계: Jev 평가 ────────────────────────────────
# TypeSafe API 키(worker만 사용, https://console.typesafe.ai). 없으면 기사는 모으고 평가는 미룬다.
TYPESAFE_API_KEY=

# ── 9단계: 외부 접속·백업 ──────────────────────────
# Docker(compose)는 아래를 스스로 정한다: 터널(tunnel 서비스), TUNNEL_METRICS_URL=http://tunnel:20241, BACKUP_DIR=/backups.
# 로컬 개발에서 자동 백업을 하려면 폴더를 적는다(비우면 백업하지 않음).
# BACKUP_DIR=./backups
# compose에서만 쓰는 값(비우면 기본값): web 포트(기본 3000), 백업을 둘 이 컴퓨터의 폴더(기본 ./backups).
# 시험용 Docker를 따로 띄울 때 바꾼다(docs/DEVELOPMENT.md).
# WEB_PORT=3000
# BACKUP_HOST_DIR=./backups

# ── 테스트용 재정의(평소에는 비워 둔다) ──────────────
# E2E가 가짜 외부 서비스를 쓰도록 바꾸는 값: OPENROUTER_BASE_URL, LISTING_KIND_URL,
# LISTING_NASDAQ_URL, LISTING_OTHER_URL, FINNHUB_BASE_URL, TYPESAFE_BASE_URL,
# RSS_FEEDS_JSON(수집할 RSS 목록, [{"id","publisher","section","url"}] 형식)
# SCHEDULER_DISABLED=1: 정기 수집과 키워드 자동 재생성을 끈다(E2E가 "지금 수집"과 겹치지 않게. 공식 목록 확인은 그대로)
